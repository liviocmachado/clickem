{
    "name": "clickem/url-shortener",
    "description": "PHP SDK oficial para o encurtador de URLs clickem.me",
    "type": "library",
    "license": "MIT",
    "keywords": ["url-shortener", "clickem", "link", "encurtador"],
    "homepage": "https://clickem.me",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "guzzlehttp/psr7": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Clickem\\UrlShortener\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Clickem\\UrlShortener\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
